{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "bun"
    ]
  },
  "include": [
    "src",
    "desktop",
    "scripts",
    "vite.config.ts",
    "host-ui",
    "website/demo",
    "website/vite.config.ts",
    "website/player.ts",
    "website/layout.ts",
    "website/build.ts",
    "website/serve.ts",
    "website/download.ts",
    "native/rune-prototype/*.ts"
  ]
}
