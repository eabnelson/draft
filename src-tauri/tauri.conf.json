{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draft",
  "version": "0.3.0-alpha.66",
  "identifier": "com.eriknelson.draft",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../resources/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/icon.icns"
    ]
  }
}
