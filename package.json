{
  "name": "draft",
  "version": "0.2.0-alpha.3",
  "type": "module",
  "scripts": {
    "dev": "bun desktop/server.ts --dev",
    "build": "tsc -b && vite build",
    "test": "bun test ./tests",
    "desktop:dev": "bun run scripts/desktop-dev.ts",
    "desktop:build": "bun run scripts/package-desktop.ts",
    "source:bundle": "bun run scripts/prepare-resources.ts",
    "release:prepare": "bun run scripts/prepare-release.ts",
    "website:dev": "bun run website:build && bun website/serve.ts",
    "website:build": "bun website/build.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.310"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "@tauri-apps/cli": "^2.11.3",
    "@types/bun": "^1.3.0"
  },
  "license": "MIT",
  "description": "A local writing app you can make your own.",
  "repository": {
    "type": "git",
    "url": "https://github.com/eabnelson/draft.git"
  }
}
