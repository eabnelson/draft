{
  "name": "draft",
  "version": "0.3.0-alpha.73",
  "type": "module",
  "scripts": {
    "native:dev": "bun native/rune-prototype/run.ts",
    "native:check": "bun native/rune-prototype/run.ts --check",
    "rune:dev": "bun native/rune-prototype/run.ts",
    "rune:snap": "bun native/rune-prototype/run.ts --snap native/rune-prototype/artifacts/editor.png --tree native/rune-prototype/artifacts/editor.json",
    "rune:check": "bun native/rune-prototype/run.ts --check",
    "dev": "bun scripts/desktop-dev.ts",
    "build": "tsc -b && vite build",
    "test": "bun test ./tests",
    "test:host": "bun test ./host-tests",
    "desktop:dev": "bun run scripts/desktop-dev.ts",
    "desktop:build": "bun scripts/package-native.ts --public",
    "release:prepare": "bun run scripts/prepare-release.ts",
    "website:dev": "bun run website:build && bun website/serve.ts",
    "website:build": "bun website/build.ts",
    "release:notarize": "bun run scripts/notarize-release.ts",
    "native:build": "bun scripts/package-native.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@lezer/markdown": "^1.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "node-diff3": "3.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  },
  "license": "MIT",
  "description": "A local writing app you can make your own.",
  "repository": {
    "type": "git",
    "url": "https://github.com/eabnelson/draft.git"
  }
}
